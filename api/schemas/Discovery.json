{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "agentsys",
    "product",
    "version",
    "protocol",
    "api_version",
    "features",
    "auth"
  ],
  "properties": {
    "agentsys": {
      "const": true
    },
    "product": {
      "const": "agentsys"
    },
    "version": {
      "type": "string"
    },
    "protocol": {
      "type": "integer"
    },
    "api_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "auth": {
      "enum": [
        "token",
        "loopback"
      ]
    },
    "server_name": {
      "type": "string"
    },
    "api": {
      "const": "/api"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "request_body_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "session_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
