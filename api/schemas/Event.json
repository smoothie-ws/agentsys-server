{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "ready",
        "change",
        "hook"
      ]
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "by": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "type": "integer"
    },
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "entry": {
      "type": "object"
    }
  }
}
